# Docker Compose database settings
POSTGRES_DB=studymate
POSTGRES_USER=studymate
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432

# Spring Boot settings when running outside Docker
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/studymate
SPRING_DATASOURCE_USERNAME=studymate
SPRING_DATASOURCE_PASSWORD=change-me-before-production
SERVER_PORT=8080
